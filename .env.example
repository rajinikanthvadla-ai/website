# Copy to .env.local for local development (never commit .env.local)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Private student feedback (/student-feedback/?k=TOKEN)
# Generate a long random string; only share the full URL with students.
NEXT_PUBLIC_FEEDBACK_ACCESS_TOKEN=change-me-to-a-long-random-token

# Supabase (approved testimonials + pending submissions)
# Create a free project → run supabase/testimonials.sql
# Settings → API Keys: Project URL + Publishable (or legacy anon) key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Optional alias if your Dashboard only shows "publishable":
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# For GitHub Pages deploy, add the same names in repo Settings → Secrets → Actions:
# NEXT_PUBLIC_GEMINI_API_KEY
# NEXT_PUBLIC_FEEDBACK_ACCESS_TOKEN
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY   (paste publishable OR anon here — one public key is enough)

